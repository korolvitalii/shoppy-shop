{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/shoppy-shop/browser",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [{ "source": "/", "destination": "/en/products", "permanent": false }],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kjpieyrj3g.eu-central-1.awsapprunner.com/api/:path*"
    },
    { "source": "/:locale/:path*", "destination": "/:locale/index.csr.html" }
  ]
}
